<Window x:Class="Ozbeca.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Özbeça" Width="780" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">

    <Grid Margin="16,8,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Chap: hero — logo, umumiy yoqish, tezkor tugma ===== -->
        <Border CornerRadius="16" Background="#FF0099B5" Margin="6,10,6,0" Opacity="0.35">
            <Border.Effect>
                <BlurEffect Radius="22" />
            </Border.Effect>
        </Border>
        <Border Style="{StaticResource Hero}">
            <Grid x:Name="HeroClip">
                <Border Background="{StaticResource Glow}" />
                <TextBlock Text="Ö" FontFamily="{StaticResource DisplayFont}" FontSize="230" FontWeight="Bold"
                           Foreground="White" Opacity="0.07" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,-34,-118" IsHitTestVisible="False" />

                <DockPanel Margin="22,22,22,16">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource Logo}" />
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Özbeça" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Yangi alifbo  ·  Ö Ğ Ş Ç" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Umumiy yoqish -->
                        <Border Style="{StaticResource Glass}" Margin="0,22,0,0">
                            <CheckBox x:Name="EnabledToggle" Style="{StaticResource Toggle}" Click="EnabledToggle_Click"
                                      AutomationProperties.Name="Özbeça yoqilgan">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,1,9,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusText" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <!-- Tezkor tugma -->
                        <Border Style="{StaticResource Glass}" Margin="0,10,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Belgilab o'girish" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                    <Button x:Name="ChangeHotkeyButton" Style="{StaticResource SubtleButton}" Padding="10,3"
                                            FontSize="12" Content="O'zgartirish" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="ChangeHotkey_Click" />
                                </Grid>
                                <TextBlock x:Name="HotkeyHint" Style="{StaticResource RowHint}" Margin="0,6,0,0"
                                           Text="Matnni belgilang va shu tugmalarni bosing." />
                                <ItemsControl x:Name="HotkeyCaps" Focusable="False" Margin="0,10,0,0"
                                              ItemsPanel="{StaticResource Horizontal}" ItemTemplate="{StaticResource KeyCapTemplate}" />
                                <TextBlock x:Name="ReverseHint" Style="{StaticResource RowHint}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <Border x:Name="HotkeyStatusBox" CornerRadius="8" Padding="10,6" Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="HotkeyStatus" FontSize="12" TextWrapping="Wrap" Foreground="White" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="2,18,0,0">
                        <TextBlock FontSize="12">
                            <Hyperlink Style="{StaticResource Link}" Click="Guide_Click">Qo'llanma</Hyperlink>
                            <Run Text="  ·  " Foreground="{DynamicResource Muted}" />
                            <Hyperlink Style="{StaticResource Link}" Click="Github_Click">GitHub</Hyperlink>
                        </TextBlock>
                        <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12" />
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ===== O'ng: sozlamalar plitkalari ===== -->
        <StackPanel Grid.Column="1" Margin="14,4,0,0">
            <TextBlock Text="Sozlamalar" Style="{StaticResource PageTitle}" Margin="5,0,0,0" />
            <TextBlock Text="Kerakli imkoniyatni bir bosishda yoqing yoki o'chiring." Style="{StaticResource RowHint}" Margin="5,2,0,8" />

            <UniformGrid Columns="2">
                <CheckBox x:Name="AutoTypeToggle" Style="{StaticResource Tile}" Tag="&#xE765;" Click="AutoTypeToggle_Click"
                          ToolTip="Kod muharrirlarida faqat qo'shtirnoq ichidagi matn o'giriladi. Terminal va parol maydonlarida ishlamaydi.">
                    <StackPanel>
                        <TextBlock Text="Yozish paytida" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="So'z tugashi bilan o'zi o'giriladi. Bekor qilish — Backspace." Style="{StaticResource RowHint}" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:Name="ApostropheToggle" Style="{StaticResource Tile}" Tag="&#xE8D2;" Click="ApostropheToggle_Click"
                          ToolTip="Faqat bir ma'noli so'zlar: ot, qol, bor kabilarga tegilmaydi.">
                    <StackPanel>
                        <TextBlock Text="Tutuqsiz so'zlar" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="ozbek → özbek, togri → töğri" Style="{StaticResource RowHint}" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:Name="ToastToggle" Style="{StaticResource Tile}" Tag="&#xEA8F;" Click="ToastToggle_Click">
                    <StackPanel>
                        <TextBlock Text="Xabar ko'rsatish" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="O'girilganda kursor yonida «Özbeça ✓»" Style="{StaticResource RowHint}" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:Name="AutostartToggle" Style="{StaticResource Tile}" Tag="&#xE7E8;" Click="AutostartToggle_Click">
                    <StackPanel>
                        <TextBlock Text="Windows bilan" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Kompyuter yoqilganda o'zi ishga tushadi" Style="{StaticResource RowHint}" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:Name="PasteToggle" Style="{StaticResource Tile}" Tag="&#xE77F;" Click="PasteToggle_Click"
                          ToolTip="Formatli matn (Word, brauzer), parol maydoni va Excel kataklariga tegilmaydi.">
                    <StackPanel>
                        <TextBlock Text="Ctrl+V da" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Qo'yilayotgan oddiy matn ham o'giriladi" Style="{StaticResource RowHint}" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:Name="PauseToggle" Style="{StaticResource Tile}" Tag="&#xE916;" Click="PauseToggle_Click"
                          ToolTip="Tugamagan so'zni ham o'zgartiradi: login yoki email yozayotganda o'chiring.">
                    <StackPanel>
                        <TextBlock Text="Pauzada" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="1 soniya to'xtasangiz, probelsiz o'giriladi" Style="{StaticResource RowHint}" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:Name="EnglishToggle" Style="{StaticResource Tile}" Tag="&#xF2B7;" Click="EnglishToggle_Click"
                          ToolTip="the, you, please kabi so'zlardan keyingi so'z (aniq o'zbekcha bo'lmasa) o'girilmaydi. check, show kabi so'zlar har doim o'zgarmaydi.">
                    <StackPanel>
                        <TextBlock Text="Inglizcha gapga tegmaslik" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="«how are you shah» o'zgarmaydi" Style="{StaticResource RowHint}" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:Name="UpdatesToggle" Style="{StaticResource Tile}" Tag="&#xE895;" Click="UpdatesToggle_Click"
                          ToolTip="Kuniga bir marta GitHub'dagi versiya raqami o'qiladi. Hech narsa yuborilmaydi va o'zi yuklab olinmaydi.">
                    <StackPanel>
                        <TextBlock Text="Yangi versiya" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Chiqqanda xabar berish (internet)" Style="{StaticResource RowHint}" />
                    </StackPanel>
                </CheckBox>
            </UniformGrid>

            <!-- Istisnolar -->
            <Border Style="{StaticResource Group}" Margin="5,5,5,0" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Badge}">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="O'girilmaydigan so'zlar" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="ExceptionsSummary" Style="{StaticResource RowHint}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Tahrirlash" Style="{StaticResource SubtleButton}" Padding="14,6"
                            VerticalAlignment="Center" Click="EditExceptions_Click" />
                </Grid>
            </Border>

            <!-- Avto-o'girish qaysi dasturlarda -->
            <Border Style="{StaticResource Group}" Margin="5,5,5,0" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Badge}">
                        <TextBlock Text="&#xE71D;" Style="{StaticResource Glyph}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Qaysi dasturlarda" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="AppsSummary" Style="{StaticResource RowHint}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Tanlash" Style="{StaticResource SubtleButton}" Padding="14,6"
                            VerticalAlignment="Center" Click="ChooseApps_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
