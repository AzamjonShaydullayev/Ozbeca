<Window x:Class="Ozbeca.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Özbeça" Width="480" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">

    <StackPanel Margin="20,14,20,18">

        <!-- Sarlavha: Ö plitkasi, nom, to'rtta yangi harf, umumiy yoqish -->
        <Grid Margin="2,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Accent}">
                <TextBlock Text="Ö" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-3,0,0" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Özbeça" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Margin="0,1,0,0" Foreground="{DynamicResource Muted}" FontSize="12.5">
                    <Run Text="Yangi alifbo:" />
                    <Run Text=" Ö  Ğ  Ş  Ç" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <CheckBox x:Name="EnabledToggle" Style="{StaticResource Toggle}" Click="EnabledToggle_Click"
                          AutomationProperties.Name="Özbeça yoqilgan">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,1,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" FontSize="13" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Grid>

        <!-- Tezkor tugma -->
        <TextBlock Text="Belgilangan matnni o'girish" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Group}">
            <Border Style="{StaticResource LastRow}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tezkor tugma" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="HotkeyHint" Style="{StaticResource RowHint}"
                                       Text="Matnni belgilang va shu tugmalarni bosing." />
                        </StackPanel>
                        <Button x:Name="ChangeHotkeyButton" Grid.Column="1" Style="{StaticResource SubtleButton}"
                                Content="O'zgartirish" VerticalAlignment="Center" Click="ChangeHotkey_Click" />
                    </Grid>
                    <ItemsControl x:Name="HotkeyCaps" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="HotkeyStatus" Style="{StaticResource RowHint}" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Yozish paytida -->
        <TextBlock Text="Yozish paytida" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Group}">
            <Border Style="{StaticResource LastRow}">
                <CheckBox x:Name="AutoTypeToggle" Style="{StaticResource Toggle}" Click="AutoTypeToggle_Click">
                    <StackPanel>
                        <TextBlock Text="Yozilgan so'zni o'zi o'girsin" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}"
                                   Text="So'z tugab probel bosilganda yangi alifboga o'tadi. Ctrl+V bilan qo'yilgan matn ham. Kod muharrirlarida faqat qo'shtirnoq ichidagi matn o'giriladi. Terminal va parol maydonlarida ishlamaydi." />
                    </StackPanel>
                </CheckBox>
            </Border>
        </Border>

        <!-- Umumiy -->
        <TextBlock Text="Umumiy" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <Border Style="{StaticResource Row}">
                    <CheckBox x:Name="ToastToggle" Style="{StaticResource Toggle}" Click="ToastToggle_Click">
                        <StackPanel>
                            <TextBlock Text="O'girilganda xabar ko'rsatish" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Kursor yonida qisqa «Özbeça ✓» chiqadi." Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox x:Name="AutostartToggle" Style="{StaticResource Toggle}" Click="AutostartToggle_Click">
                        <StackPanel>
                            <TextBlock Text="Kompyuter yoqilganda ishga tushirish" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Dastur soat yonidagi Ö belgisida jim kutib turadi." Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource LastRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Clipboard'ni tiklash kechikishi" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Word kabi ilovalarda matn qo'yilmay qolsa, oshiring." Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="DelayBox" Style="{StaticResource Field}" Width="64" TextAlignment="Right"
                                     LostKeyboardFocus="DelayBox_LostFocus" AutomationProperties.Name="Kechikish, millisekund" />
                            <TextBlock Text="ms" Foreground="{DynamicResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Pastki qism -->
        <Grid Margin="2,4,2,0">
            <TextBlock Foreground="{DynamicResource Muted}" FontSize="12">
                <Hyperlink Style="{StaticResource Link}" Click="Guide_Click">Qo'llanma</Hyperlink>
                <Run Text="   " />
                <Hyperlink Style="{StaticResource Link}" Click="Github_Click">GitHub</Hyperlink>
            </TextBlock>
            <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12" />
        </Grid>
    </StackPanel>
</Window>
