<Window x:Class="Ozbeca.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Özbeça — Sozlamalar" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,22">
        <TextBlock Text="Hotkey" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" FontSize="14"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0"
                   Text="Maydonni bosing va yangi kombinatsiyani bosing. Matnni belgilab, shu tugmalarni bossangiz — matn yangi alifboga o'giriladi." />
        <TextBlock x:Name="HotkeyStatus" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <Separator Margin="0,14,0,8" Background="{DynamicResource Line}" />

        <CheckBox x:Name="ToastBox" Content="O'girilganda xabar ko'rsatish" Click="ToastBox_Click" />
        <CheckBox x:Name="AutostartBox" Content="Windows bilan birga ishga tushirish" Click="AutostartBox_Click" />

        <Expander Header="Kengaytirilgan" Margin="0,14,0,0" Foreground="{DynamicResource Fg}">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Clipboard'ni tiklashdan oldingi kechikish (ms)" />
                <TextBox x:Name="DelayBox" Width="90" HorizontalAlignment="Left" Margin="0,6,0,0"
                         LostKeyboardFocus="DelayBox_LostFocus" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0"
                           Text="Word kabi ilovalar clipboard'ni kechroq o'qiydi. Qo'yilmay qolsa, qiymatni oshiring." />
            </StackPanel>
        </Expander>
    </StackPanel>
</Window>
