<Window x:Class="Ozbeca.App.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" Width="384" SizeToContent="Height" Opacity="0"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource Fg}"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" MouseLeftButtonUp="Window_Click">
    <!-- Soat yonidan chiqadigan bildirishnoma (tray balloon o'rniga) -->
    <Border x:Name="Card" Margin="16" CornerRadius="14" Background="{DynamicResource Card}"
            BorderBrush="{DynamicResource CardLine}" BorderThickness="1" Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.3" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardMove" X="0" />
        </Border.RenderTransform>
        <Grid>
            <!-- chapdagi firuza chiziq -->
            <Border x:Name="Stripe" Width="3" HorizontalAlignment="Left" CornerRadius="1.5" Margin="6,16,0,16"
                    Background="{StaticResource AccentGradient}" />
            <Grid Margin="16,14,10,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl Style="{StaticResource Logo}" Width="40" Height="40" FontSize="23" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="12,1,8,0">
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock x:Name="MessageText" Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                               LineHeight="18" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"
                           Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,4,4,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
