<Window x:Class="Ozbeca.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" Opacity="0">
    <Border CornerRadius="8" Background="#EE1F1F1F" BorderBrush="#33FFFFFF" BorderThickness="1"
            Padding="12,6" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <TextBlock x:Name="MessageText" Foreground="White" FontFamily="Segoe UI" FontSize="13" />
    </Border>
</Window>
