<Window x:Class="Ozbeca.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" Opacity="0">
    <Border CornerRadius="17" Background="#F2202428" BorderBrush="#26FFFFFF" BorderThickness="1"
            Padding="6,6,14,6" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.28" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Border Width="22" Height="22" CornerRadius="11" Background="#FF0099B5">
                <TextBlock Text="Ö" Foreground="White" FontSize="13" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
            </Border>
            <TextBlock x:Name="MessageText" Foreground="White" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
                       VerticalAlignment="Center" Margin="9,0,0,1" />
        </StackPanel>
    </Border>
</Window>
