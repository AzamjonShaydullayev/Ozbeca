<Window x:Class="Ozbeca.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Özbeça — o'rnatish" Width="820" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        Loaded="Window_Loaded">

    <Grid Margin="16,8,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Chap: hero — salom va jonli namuna ===== -->
        <Border CornerRadius="16" Background="#FF0099B5" Margin="6,10,6,0" Opacity="0.35">
            <Border.Effect>
                <BlurEffect Radius="22" />
            </Border.Effect>
        </Border>
        <Border Style="{StaticResource Hero}">
            <Grid x:Name="HeroClip">
                <Border Background="{StaticResource Glow}" />
                <TextBlock Text="Ö" FontFamily="{StaticResource DisplayFont}" FontSize="230" FontWeight="Bold"
                           Foreground="White" Opacity="0.07" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,-34,-118" IsHitTestVisible="False" />

                <DockPanel Margin="24,24,24,18">
                    <StackPanel DockPanel.Dock="Top">
                        <ContentControl Style="{StaticResource Logo}" Width="60" Height="60" FontSize="34" HorizontalAlignment="Left" />
                        <TextBlock Text="Xush kelibsiz!" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"
                                   Margin="0,18,0,0" />
                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"
                                   Text="Özbeça o'zbekcha matnni yangi lotin alifbosiga o'zi o'girib beradi." />

                        <!-- Jonli namuna: bir marta, oyna ochilganda -->
                        <Border Style="{StaticResource Glass}" Margin="0,22,0,0" Padding="18,14">
                            <StackPanel>
                                <TextBlock x:Name="DemoOld" Text="O'zbekiston" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                           Foreground="{DynamicResource Muted}" />
                                <TextBlock x:Name="DemoArrow" Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource Muted}" Margin="2,6,0,6" Opacity="0" />
                                <TextBlock x:Name="DemoNew" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Opacity="0">
                                    <Run Text="Ö" Foreground="#FFB8F3FF" /><Run Text="zbekiston" />
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="DemoNewMove" Y="8" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,18,0,0">
                        <TextBlock Text="&#xE83D;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="Administrator huquqi kerak emas" Foreground="{DynamicResource Muted}" FontSize="12"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ===== O'ng: qanday ishlaydi + o'rnatish ===== -->
        <StackPanel Grid.Column="1" Margin="18,4,0,0">
            <TextBlock Text="Ikki yo'l bilan ishlaydi" Style="{StaticResource PageTitle}" Margin="5,0,0,0" />
            <TextBlock Text="Ikkalasi ham doim tayyor — keyin sozlamalarda o'zgartirsa bo'ladi." Style="{StaticResource RowHint}" Margin="5,2,0,8" />

            <UniformGrid Columns="2">
                <CheckBox x:Name="AutoTypeBox" Style="{StaticResource Tile}" Tag="&#xE765;" IsChecked="True"
                          ToolTip="Kodda faqat qo'shtirnoq ichidagi matn o'giriladi, terminal va parollarga tegmaydi.">
                    <StackPanel>
                        <TextBlock Text="Shunchaki yozing" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="So'z tugashi bilan o'zi yangi alifboga o'tadi." Style="{StaticResource RowHint}" />
                    </StackPanel>
                </CheckBox>
                <Border Style="{StaticResource Group}" Margin="5" Padding="16,14,16,15">
                    <StackPanel>
                        <Border Style="{StaticResource Badge}">
                            <TextBlock Text="&#xE8B3;" Style="{StaticResource Glyph}" />
                        </Border>
                        <TextBlock Text="Belgilab o'giring" Style="{StaticResource RowTitle}" Margin="0,12,0,0" />
                        <ItemsControl x:Name="HotkeyCaps" Focusable="False" Margin="0,7,0,0"
                                      ItemsPanel="{StaticResource Horizontal}" ItemTemplate="{StaticResource KeyCapTemplate}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="O'RNATISH" Style="{StaticResource SectionTitle}" Margin="7,14,0,4" />
            <UniformGrid Columns="2" Margin="1,0">
                <CheckBox x:Name="InstallBox" Style="{StaticResource Chip}" IsChecked="True" Content="Kompyuterga o'rnatish"
                          ToolTip="Dastur doimiy papkaga ko'chiriladi — yuklab olingan faylni keyin o'chirib tashlasangiz bo'ladi." />
                <CheckBox x:Name="AutostartBox" Style="{StaticResource Chip}" IsChecked="True" Content="Avtomatik ishga tushish"
                          ToolTip="Soat yonidagi Ö belgisida jim kutib turadi." />
                <CheckBox x:Name="DesktopBox" Style="{StaticResource Chip}" IsChecked="True" Content="Ish stolida yorliq" />
                <CheckBox x:Name="StartMenuBox" Style="{StaticResource Chip}" IsChecked="True" Content="Start menyusiga qo'shish" />
            </UniformGrid>

            <Button Content="Boshlash" IsDefault="True" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    MinWidth="150" Margin="0,18,5,0" Click="Done_Click" />
        </StackPanel>
    </Grid>
</Window>
