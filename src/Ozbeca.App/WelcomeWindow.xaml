<Window x:Class="Ozbeca.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Özbeça — o'rnatish" Width="500" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        Loaded="Window_Loaded">

    <StackPanel Margin="22,16,22,20">

        <!-- Sarlavha -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource Accent}">
                <TextBlock Text="Ö" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
            </Border>
            <TextBlock Text="Özbeça'ga xush kelibsiz" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
        </StackPanel>

        <!-- Jonli namuna: bir marta, oyna ochilganda -->
        <Border Style="{StaticResource Group}" Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DemoOld" Text="O'zbekiston" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                <TextBlock x:Name="DemoArrow" Grid.Column="1" Text="→" FontSize="22" Margin="14,0" Opacity="0"
                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                <TextBlock x:Name="DemoNew" Grid.Column="2" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                           FontWeight="SemiBold" VerticalAlignment="Center" Opacity="0">
                    <Run Text="Ö" Foreground="{DynamicResource Accent}" /><Run Text="zbekiston" />
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="DemoNewMove" X="10" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Qanday ishlaydi -->
        <TextBlock Text="Ikki yo'l bilan ishlaydi" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <Border Style="{StaticResource Row}">
                    <CheckBox x:Name="AutoTypeBox" Style="{StaticResource Toggle}" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="Shunchaki yozing" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="So'z tugab probel bosilganda yangi alifboga o'tadi. Kodda faqat qo'shtirnoq ichidagi matn o'giriladi, terminal va parollarga tegmaydi." />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource LastRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tayyor matnni o'giring" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource RowHint}" Text="Matnni belgilab shu tugmalarni bosing." />
                        </StackPanel>
                        <ItemsControl x:Name="HotkeyCaps" Grid.Column="1" VerticalAlignment="Center" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource KeyCap}">
                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- O'rnatish -->
        <TextBlock Text="O'rnatish" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <Border x:Name="InstallRow" Style="{StaticResource Row}">
                    <CheckBox x:Name="InstallBox" Style="{StaticResource Toggle}" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="Kompyuterga o'rnatish" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="InstallNote" Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox x:Name="DesktopBox" Style="{StaticResource Toggle}" IsChecked="True">
                        <TextBlock Text="Ish stolida yorliq" Style="{StaticResource RowTitle}" />
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox x:Name="StartMenuBox" Style="{StaticResource Toggle}" IsChecked="True">
                        <TextBlock Text="Start menyusiga qo'shish" Style="{StaticResource RowTitle}" />
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource LastRow}">
                    <CheckBox x:Name="AutostartBox" Style="{StaticResource Toggle}" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="Kompyuter yoqilganda ishga tushirish" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource RowHint}" Text="Soat yonidagi Ö belgisida jim kutib turadi." />
                        </StackPanel>
                    </CheckBox>
                </Border>
            </StackPanel>
        </Border>

        <Grid Margin="0,6,0,0">
            <TextBlock Text="Administrator huquqi kerak emas." Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
            <Button Content="Boshlash" IsDefault="True" Style="{StaticResource AccentButton}" HorizontalAlignment="Right"
                    MinWidth="120" Padding="20,8" Click="Done_Click" />
        </Grid>
    </StackPanel>
</Window>
