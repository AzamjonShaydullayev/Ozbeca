<Window x:Class="Ozbeca.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Özbeça — o'rnatish" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/Assets/ozbeca.ico" Width="40" Height="40" />
            <TextBlock Text="Özbeça'ga xush kelibsiz!" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <TextBlock x:Name="HowTo" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="20" />

        <Separator Margin="0,16,0,4" Background="{DynamicResource Line}" />

        <CheckBox x:Name="InstallBox" IsChecked="True" Content="Kompyuterga o'rnatish" />
        <TextBlock x:Name="InstallNote" Style="{StaticResource Muted}" Margin="22,2,0,0" />
        <CheckBox x:Name="DesktopBox" IsChecked="True" Content="Ish stolida yorliq yaratish" />
        <CheckBox x:Name="StartMenuBox" IsChecked="True" Content="Start menyusiga qo'shish" />
        <CheckBox x:Name="AutostartBox" IsChecked="True" Content="Kompyuter yoqilganda avtomatik ishga tushirish" />
        <TextBlock Style="{StaticResource Muted}" Margin="22,2,0,0"
                   Text="Tavsiya etiladi: dastur doim tayyor turadi, ekranda hech narsa ochmaydi." />

        <Button Content="Tayyor" IsDefault="True" HorizontalAlignment="Right" MinWidth="110" Padding="16,6"
                Margin="0,22,0,0" Click="Done_Click" />
    </StackPanel>
</Window>
