<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET Framework 4.8 — Windows 10/11 ichida allaqachon bor: foydalanuvchi hech narsa o'rnatmaydi,
    exe esa ~0.25 MB, shundan ~0.1 MB tutuqsiz so'zlar lug'ati (self-contained .NET 8 da 68 MB edi).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- faqat tray NotifyIcon uchun -->
    <Nullable>enable</Nullable>
    <AssemblyName>Ozbeca</AssemblyName>
    <RootNamespace>Ozbeca.App</RootNamespace>
    <ApplicationIcon>Assets\ozbeca.ico</ApplicationIcon>
    <Product>Özbeça</Product>
    <Version>1.6.1</Version>
    <Copyright>AzamjonShaydullayev</Copyright>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core kodi exe ichiga kiradi — alohida DLL bo'lmasin (bitta fayl). -->
    <Compile Include="..\Ozbeca.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Ozbeca.Core\words.txt" LogicalName="Ozbeca.words.txt" Link="Core\words.txt" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="Microsoft.CSharp" />  <!-- dynamic: Shell.Application (dasturlar ro'yxati) -->
    <Reference Include="UIAutomationClient" />  <!-- avto-yozishda parol maydonini aniqlash -->
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ozbeca.ico" />
  </ItemGroup>

</Project>
