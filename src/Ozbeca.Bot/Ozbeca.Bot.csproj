<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ozbeca.Bot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\*.json" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\game_words.txt;Widget\card.html" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.34" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ozbeca.Core\Ozbeca.Core.csproj" />
  </ItemGroup>

</Project>
