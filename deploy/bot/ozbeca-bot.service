[Unit]
Description=Ozbeca Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
User=ozbeca
WorkingDirectory=/opt/ozbeca-bot
EnvironmentFile=/opt/ozbeca-bot/.env
ExecStart=/opt/ozbeca-bot/Ozbeca.Bot
Restart=always
RestartSec=5
CPUQuota=50%
MemoryMax=300M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ozbeca-bot/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
